PORT=4000

# Jornada ordinaria semanal (horas) - Art. 32 Codigo del Trabajo
# TODO: validar valor legal vigente
JORNADA_SEMANAL_MAX_HORAS=45

# Recargo sobre el valor hora ordinaria para horas extra (0.5 = 50%) - Art. 32
# TODO: validar valor legal vigente
RECARGO_HORA_EXTRA=0.5

# Horas mensuales de jornada usadas para calcular el valor de la hora ordinaria
# TODO: validar formula legal vigente
HORAS_MENSUALES_JORNADA=180

# Liquidaciones de sueldo (RF-09) - cotizaciones, gratificacion
# TODO: validar valores legales vigentes (Codigo del Trabajo / Direccion del Trabajo)
DESCUENTO_AFP_PORCENTAJE=0.10
DESCUENTO_SALUD_PORCENTAJE=0.07
AFC_TRABAJADOR_INDEFINIDO_PORCENTAJE=0.006
AFC_TRABAJADOR_PLAZO_FIJO_PORCENTAJE=0
GRATIFICACION_PORCENTAJE=0.25
GRATIFICACION_TOPE_MENSUAL=240000

# Alertas de vencimiento de contrato (RF-05) - dias de anticipacion antes de avisar
ALERTA_DIAS_ANTICIPACION=30

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=personal_pymes

JWT_SECRET=cambiar_este_valor
JWT_EXPIRES_IN=8h

# Usuario administrador inicial (RF-01) - npm run seed:admin lo crea/actualiza.
# Es una contrasena generica: el primer login obliga a cambiarla (ver migracion 002).
ADMIN_EMAIL=admin@pyme.cl
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=cambiar_esta_clave

# Repositorio de documentos (RF-11). Si se deja vacio, los documentos se guardan en
# disco local (backend/uploads/documentos) - no requiere crear una cuenta para
# desarrollar o correr los tests. Para usar Cloudinary (plan gratuito), crear una
# cuenta en https://cloudinary.com, copiar el "API Environment variable" desde el
# dashboard (formato cloudinary://<api_key>:<api_secret>@<cloud_name>) y pegarlo aqui.
CLOUDINARY_URL=
